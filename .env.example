# ==============================================================================
# GitResolve — Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# Google Cloud / Agent Platform (Vertex AI Ecosystem)
# Authentication: Application Default Credentials (ADC)
# Run `gcloud auth application-default login` for local development.
# ------------------------------------------------------------------------------
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_ENTERPRISE=true

# ------------------------------------------------------------------------------
# Anthropic on Google Cloud (Managed Partner Model)
# Authentication: Application Default Credentials (ADC)
# ------------------------------------------------------------------------------
ANTHROPIC_VERTEX_PROJECT_ID=your-gcp-project-id
ANTHROPIC_VERTEX_REGION=global

# ------------------------------------------------------------------------------
# Model Routing Hierarchy
# - Primary: Normal execution
# - Fallback 1: First technical/transient provider failover
# - Fallback 2: Second technical/transient provider failover
# - Escalation: High-difficulty reasoning and repair escalation
# ------------------------------------------------------------------------------
LLM_PRIMARY_PROVIDER=anthropic
LLM_PRIMARY_MODEL=claude-sonnet-5-5

LLM_FALLBACK_1_PROVIDER=google
LLM_FALLBACK_1_MODEL=gemini-4-argon

LLM_FALLBACK_2_PROVIDER=google
LLM_FALLBACK_2_MODEL=gemini-3.8-flash

LLM_ESCALATION_PROVIDER=anthropic
LLM_ESCALATION_MODEL=claude-opus-5-5

# ------------------------------------------------------------------------------
# Routing & Resilience Behavior
# ------------------------------------------------------------------------------
LLM_MAX_PROVIDER_RETRIES=2
LLM_ENABLE_FAILOVER=true
LLM_ENABLE_OPUS_ESCALATION=true
LLM_MAX_OPUS_ESCALATIONS=1
LLM_RETRY_INITIAL_DELAY=0.5
LLM_RETRY_BACKOFF_FACTOR=2.0
LLM_RETRY_MAX_DELAY=8.0
LLM_REQUEST_TIMEOUT_SECONDS=180
LLM_MAX_OUTPUT_TOKENS=8192
LLM_THINKING_LEVEL=LOW
