# ==============================================================================
# GitResolve — Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# Google Cloud / Agent Platform (Vertex AI Ecosystem)
# Authentication: Application Default Credentials (ADC)
# Run `gcloud auth application-default login` for local development.
# ------------------------------------------------------------------------------
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_ENTERPRISE=true

# ------------------------------------------------------------------------------
# Authentication: Application Default Credentials (ADC)
# ------------------------------------------------------------------------------

# ------------------------------------------------------------------------------
# Model Routing Hierarchy
# - Primary: Normal execution
# - Fallback: Technical/transient provider failover
# - Specialist: One reasoning review after a successful quality failure
# ------------------------------------------------------------------------------

LLM_PRIMARY_PROVIDER=google
LLM_PRIMARY_MODEL=gemini-3.8-flash
LLM_FALLBACK_1_PROVIDER=google
LLM_FALLBACK_1_MODEL=gemini-3.6-flash



# ------------------------------------------------------------------------------
# Routing & Resilience Behavior
# ------------------------------------------------------------------------------
LLM_MAX_PROVIDER_RETRIES=1
LLM_ENABLE_FAILOVER=true
LLM_RETRY_INITIAL_DELAY=0.5
LLM_RETRY_BACKOFF_FACTOR=2.0
LLM_RETRY_MAX_DELAY=2.0
LLM_REQUEST_TIMEOUT_SECONDS=45
LLM_MAX_OUTPUT_TOKENS=8192
LLM_THINKING_LEVEL=LOW
LLM_SPECIALIST_MODEL=gemini-4-argon
LLM_SPECIALIST_TIMEOUT_SECONDS=60
