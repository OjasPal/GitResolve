# Non-secret production settings for Cloud Run (TRD section 10).
# Copy to deploy/env.production.yaml and edit. Secrets are NOT set here: they come
# from Secret Manager (see deploy/deploy.sh --set-secrets). Values must be quoted strings.
ENVIRONMENT: "production"
STORE_BACKEND: "firestore"
GCP_PROJECT: "your-gcp-project-id"
FIRESTORE_DATABASE: "(default)"
GITHUB_APP_ID: "123456"
GITHUB_APP_CLIENT_ID: "Iv1.replace_me"
# AUTO = the deploy script fills in https://gitresolve-api-<project-number>.<region>.run.app/api/v1/auth/github/callback
GITHUB_APP_CALLBACK_URL: "AUTO"
FRONTEND_BASE_URL: "https://gitresolve.vercel.app"
CORS_ORIGINS: '["https://gitresolve.vercel.app"]'
# Cloud Run puts one Google proxy in front of the container; used for per-IP rate limits.
TRUSTED_PROXY_HOPS: "1"
