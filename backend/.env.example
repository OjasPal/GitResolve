# Secrets only. See README.md for local runtime settings.
GEMINI_API_KEY=replace_with_your_gemini_api_key
SESSION_JWT_SECRET=replace_with_random_32_plus_byte_secret

# fixture is credential-free and is the local/CI default.
GITHUB_MODE=fixture
# Optional single-process local persistence. Use an absolute path in your checkout:
# LOCAL_STATE_PATH=/absolute/path/to/GitResolve/.diagnostics/local-state.json
# For real mode: create/install a GitHub App; use OAuth to sign in.
# GITHUB_APP_ID=123456
# GITHUB_APP_CLIENT_ID=Iv1.example
# GITHUB_APP_CLIENT_SECRET=replace_me
# Use either a secret PEM value or a host-only private key path (never commit it).
# GITHUB_APP_PRIVATE_KEY_PATH=/run/secrets/github-app.pem
# GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----..."
# Optional: restrict the app to one installation.
# GITHUB_INSTALLATION_ID=123456
# GITHUB_APP_CALLBACK_URL=http://localhost:8000/api/v1/auth/github/callback
# FRONTEND_BASE_URL=http://localhost:3000
# No webhook endpoint or webhook secret is used in this milestone.
